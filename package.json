{
  "name": "quadwear",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-env.cjs ci-build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/prisma-env.cjs generate",
    "db:migrate": "node scripts/prisma-env.cjs migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:resolve-init-applied": "node scripts/prisma-env.cjs migrate resolve --applied 20250409120000_init_postgresql",
    "db:seed": "prisma db seed",
    "make-circular-favicons": "node scripts/make-circular-favicons.js",
    "vercel:deploy": "vercel",
    "vercel:deploy:prod": "vercel --prod",
    "vercel:pull": "vercel env pull .env.local"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@stripe/stripe-js": "^4.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8",
    "prisma": "^5.19.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vercel": "^53.3.1"
  }
}
