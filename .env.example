# Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database (PostgreSQL — Supabase / Vercel Postgres)
# Runtime: pooled connection (PgBouncer / port 6543). Prisma Client uses this URL.
DATABASE_URL="postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true"
# Migrations: direct connection (bypasses pooler; port 5432). Required for `prisma migrate dev` / `migrate deploy`.
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
#
# If you use the Vercel Supabase integration, map: DATABASE_URL ← POSTGRES_PRISMA_URL, DIRECT_URL ← POSTGRES_URL_NON_POOLING

# Zoho Mail (SMTP) — contact form / server-side email
# Use the same mailbox you configured in Zoho (e.g. support@quadwearshop.com).
# If 2FA is on, create an App Password in Zoho and use it for SMTP_PASSWORD.
# EU accounts: try SMTP_HOST=smtp.zoho.eu
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@quadwearshop.com
SMTP_PASSWORD=
# Where inbound contact submissions are delivered (usually same as support inbox)
CONTACT_TO_EMAIL=support@quadwearshop.com
# "From" address for automated mail (must be allowed in Zoho for that mailbox)
CONTACT_FROM_EMAIL=support@quadwearshop.com
